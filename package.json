{
  "name": "cat-sitter",
  "version": "0.0.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration production --base-href /cat-sitter/",
    "deploy": "ng build --configuration production --base-href /cat-sitter/ && npx gh-pages -d dist/cat-sitter/browser",
    "dev": "concurrently \"npm run start:backend\" \"npm run start\"",
    "start:backend": "cd backend && GOOGLE_APPLICATION_CREDENTIALS=\"./serviceAccountKey.json\" npm start"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.0.0",
    "@angular/common": "^19.0.0",
    "@angular/compiler": "^19.0.0",
    "@angular/core": "^19.0.0",
    "@angular/fire": "^19.2.0",
    "@angular/forms": "^19.0.0",
    "@angular/platform-browser": "^19.0.0",
    "@angular/platform-browser-dynamic": "^19.0.0",
    "firebase": "^12.19.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.0.0",
    "@angular/cli": "^19.0.0",
    "@angular/compiler-cli": "^19.0.0",
    "concurrently": "^10.0.5",
    "gh-pages": "^6.0.0",
    "typescript": "~5.6.0"
  }
}
